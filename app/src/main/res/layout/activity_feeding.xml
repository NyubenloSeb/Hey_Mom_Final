<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:gravity="bottom"
        android:background="@color/purple2"
        app:title="Feeding Routine"
        app:titleTextAppearance="@style/ToolbarTitleBoldLarge" />

    <!-- Scrollable Content Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Input Form Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_corner"
                android:backgroundTint="@color/white2"
                android:padding="16dp"
                android:layout_marginBottom="20dp"
                android:elevation="2dp">

                <!-- Time Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Feeding Time">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFeedingTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="yyyy-MM-dd HH:mm:ss"
                        android:textColor="@color/black"
                        android:inputType="datetime"
                        android:drawablePadding="12dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Type Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Feeding Type">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFeedingType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., Formula, Breast Milk"
                        android:textColor="@color/black"
                        android:inputType="text"
                        android:drawablePadding="12dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Quantity Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Quantity (ml)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuantity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Amount in milliliters"
                        android:inputType="number"
                        android:textColor="@color/black"
                        android:drawablePadding="12dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Notes Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Notes (Optional)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFeedingNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Additional notes or observations"
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:textColor="@color/black"
                        android:drawablePadding="12dp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Add Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddFeeding"
                    android:layout_width="match_parent"
                    android:textColor="@color/white"
                    android:layout_height="56dp"
                    android:text="Add Feeding Entry"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/purple2"
                    android:elevation="4dp"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/darker_gray"
                android:layout_marginBottom="16dp"
                android:alpha="0.3" />

            <!-- Feeding History Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Feeding History"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="12dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical" />

            <!-- RecyclerView Container for Fixed Height -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:background="@color/white2">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerFeeding"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:scrollbars="vertical"
                    android:padding="8dp" />

            </FrameLayout>

            <!-- Bottom Spacer for Better Scrolling -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>